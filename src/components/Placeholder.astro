---
/** Striped placeholder box, or the real image when one is supplied. */
interface Props {
  src?: string | null;
  alt?: string;
  caption?: string | null;
  class?: string;
  /**
   * Wrap the image in the offset hairline edge used by the hero portrait.
   * Applied to real images only: the striped placeholder already draws its
   * own border, and a second offset rectangle behind it reads as a mistake
   * rather than a frame.
   */
  frame?: boolean;
}
const {
  src,
  alt = '',
  caption = null,
  class: cls = '',
  frame = false,
} = Astro.props;
---

<div class={cls}>
  {
    src ? (
      frame ? (
        <div class="frame">
          <img src={src} alt={alt} loading="lazy" />
        </div>
      ) : (
        <img src={src} alt={alt} loading="lazy" />
      )
    ) : (
      <div class="ph" aria-hidden="true" />
    )
  }
  {!src && caption && <span class="ph-caption">{caption}</span>}
</div>
