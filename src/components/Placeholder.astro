---
/** Striped placeholder box, or the real image when one is supplied. */
import { Image } from 'astro:assets';

interface Props {
  /** An image from the `image:` frontmatter field (or any import from src/). */
  src?: ImageMetadata | null;
  alt?: string;
  caption?: string | null;
  class?: string;
  /**
   * Wrap the image in the offset hairline edge used by the hero portrait.
   * Applied to real images only: the striped placeholder already draws its
   * own border, and a second offset rectangle behind it reads as a mistake
   * rather than a frame.
   */
  frame?: boolean;
  /** Widths to generate, in px: roughly 1x and 2x the largest size the
   *  image is shown at. The browser picks one using `sizes`. */
  widths: number[];
  /** Mirrors the CSS width, e.g. '(max-width: 640px) 100vw, 420px'. */
  sizes: string;
  loading?: 'lazy' | 'eager';
}
const {
  src,
  alt = '',
  caption = null,
  class: cls = '',
  frame = false,
  widths,
  sizes,
  loading = 'lazy',
} = Astro.props;
---

<div class={cls}>
  {
    src ? (
      frame ? (
        <div class="frame">
          <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} decoding="async" />
        </div>
      ) : (
        <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} decoding="async" />
      )
    ) : (
      <div class="ph" aria-hidden="true" />
    )
  }
  {!src && caption && <span class="ph-caption">{caption}</span>}
</div>
