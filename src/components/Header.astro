---
import { site, nav } from '../config/site';
import { url } from '../lib/format';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href={url('/')}>{site.name}</a>
    <nav class="site-nav" aria-label="Primary">
      {nav.map((item) => <a href={url(item.href)}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <ThemeToggle />
      <a class="btn btn-sm btn-ghost" href={`mailto:${site.email}`}>Get in touch</a>
    </div>
  </div>
</header>
