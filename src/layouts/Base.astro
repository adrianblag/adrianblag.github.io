---
import { ClientRouter } from 'astro:transitions';
import { site } from '../config/site';
import { url } from '../lib/format';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  /** Page title. Rendered as "<title> · <your name>"; omit on the homepage. */
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />

    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#f7faf6"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#101711"
    />

    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />

    {/* Must run before first paint, and must not be bundled or deferred,
        or the page flashes the wrong theme. Kept small and dependency-free. */}
    <script is:inline>
      (() => {
        const KEY = 'theme';
        const root = document.documentElement;
        const mq = window.matchMedia('(prefers-color-scheme: dark)');

        const stored = () => {
          try {
            const v = localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : null;
          } catch {
            return null; // private mode, blocked storage
          }
        };

        // Sets the attribute the CSS keys off. Must be able to run in <head>,
        // before <body> exists, so it must not touch the button.
        // Also marks <html> with .js, which lets the scroll reveals hide
        // content only when the script that shows it again can run.
        const apply = () => {
          root.dataset.theme = stored() ?? (mq.matches ? 'dark' : 'light');
          root.classList.add('js');
        };

        // Separate, because on first load apply() runs before the button has
        // been parsed — syncing there would silently do nothing and leave
        // aria-pressed stuck at the server-rendered value.
        const syncButtons = () => {
          const pressed = String(root.dataset.theme === 'dark');
          document
            .querySelectorAll('[data-theme-toggle]')
            .forEach((b) => b.setAttribute('aria-pressed', pressed));
        };

        apply();
        document.addEventListener('DOMContentLoaded', syncButtons);
        // Fires on first load and after every view transition.
        document.addEventListener('astro:page-load', syncButtons);

        // ClientRouter copies <html> attributes from the incoming document,
        // which has no data-theme (or .js), so re-apply on every view
        // transition.
        document.addEventListener('astro:after-swap', apply);

        // Keep following the OS until the visitor makes an explicit choice.
        mq.addEventListener('change', () => {
          if (!stored()) {
            apply();
            syncButtons();
          }
        });

        // Delegated, so it survives page swaps without re-binding.
        document.addEventListener('click', (e) => {
          const btn = e.target.closest && e.target.closest('[data-theme-toggle]');
          if (!btn) return;
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          try {
            localStorage.setItem(KEY, next);
          } catch {}
          apply();
          syncButtons();
        });
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {/* Marks the top of the page; once it scrolls away the header gets
        its hairline. */}
    <div class="scroll-sentinel" aria-hidden="true"></div>
    <div class="site">
      <Header />
      <main class="site-main" id="main">
        <slot />
      </main>
      <Footer />
    </div>

    <script>
      import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

      /* One-shot scroll reveals (.reveal → .is-in) and the header hairline.
         IntersectionObserver only calls back when an element crosses the
         edge of the screen, so nothing here runs while the page is simply
         scrolling. Set up again on every page, including after a view
         transition; the previous page's observers are dropped first. */
      let observers: IntersectionObserver[] = [];

      function init() {
        observers.forEach((o) => o.disconnect());

        const reveal = new IntersectionObserver(
          (entries) => {
            let i = 0; // staggers items that arrive together
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              el.style.setProperty('--i', String(i++));
              el.classList.add('is-in');
              reveal.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -6% 0px' }
        );
        document
          .querySelectorAll('.reveal, .timeline')
          .forEach((el) => reveal.observe(el));

        const header = document.querySelector('.site-header');
        const hairline = new IntersectionObserver(([entry]) =>
          header?.classList.toggle('is-scrolled', !entry.isIntersecting)
        );
        const sentinel = document.querySelector('.scroll-sentinel');
        if (sentinel) hairline.observe(sentinel);

        observers = [reveal, hairline];
      }

      // Fires on the first load and after every view transition.
      document.addEventListener('astro:page-load', init);

      // Section links glide there (scroll-behavior: smooth in global.css), but
      // Back and Forward to another page should land where you were at once,
      // not glide down from the top. The router swaps the page, restores the
      // scroll position, and only then fires after-swap, so the override goes
      // in right after the swap and comes out on after-swap.
      document.addEventListener('astro:before-swap', (e) => {
        const ev = e as TransitionBeforeSwapEvent;
        if (ev.navigationType !== 'traverse') return;
        const swap = ev.swap;
        ev.swap = () => {
          swap();
          document.documentElement.style.scrollBehavior = 'auto';
        };
      });
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.style.removeProperty('scroll-behavior');
      });

      // Printing the homepage prints the whole profile: open every folded
      // list first, and close the ones we opened afterwards.
      addEventListener('beforeprint', () => {
        document.querySelectorAll<HTMLDetailsElement>('details.more-list:not([open])').forEach((d) => {
          d.open = true;
          d.dataset.printOpened = '';
        });
      });
      addEventListener('afterprint', () => {
        document.querySelectorAll<HTMLDetailsElement>('details[data-print-opened]').forEach((d) => {
          d.open = false;
          delete d.dataset.printOpened;
        });
      });
    </script>
  </body>
</html>
