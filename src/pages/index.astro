---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MoreList from '../components/MoreList.astro';
import ObjectiveMap from '../components/ObjectiveMap.astro';
import Organization from '../components/Organization.astro';
import Placeholder from '../components/Placeholder.astro';
import PostRow from '../components/PostRow.astro';
import PublicationRow from '../components/PublicationRow.astro';
import RoleEntry from '../components/RoleEntry.astro';
import SectionHead from '../components/SectionHead.astro';
import TalkRow from '../components/TalkRow.astro';
import TrainingEntry from '../components/TrainingEntry.astro';
import { site, skills } from '../config/site';
import { cvSection, dateLabel } from '../lib/cv';
import { emphasize, plural, readingMinutes, stampDate, url } from '../lib/format';

/* The whole profile on one page. Every section lists all of its entries,
   newest first: the first few are shown, and the rest fold under a toggle
   that says how many there are (MoreList). It all comes from the content
   files, so adding an entry never needs a change here. */

/** How many entries each list shows before folding the rest. */
const SHOW = { roles: 3, training: 1, publications: 2, talks: 2 };

/* ---- CV ----------------------------------------------------------------- */
const experience = cvSection('employment');
const education = cvSection('education');
const training = cvSection('training');

/* ---- Publications: featured first, then newest -------------------------- */
const pubs = (await getCollection('publications')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.year - a.data.year ||
    (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);

/* ---- Talks: newest first ------------------------------------------------ */
const talks = (await getCollection('talks')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

/* ---- Writing: newest first (drafts only show in `npm run dev`) ---------- */
const posts = (await getCollection('posts'))
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const [latest, ...olderPosts] = posts;

/* ---- Section numbers, so they stay in sequence if one is empty ---------- */
const present = {
  experience: experience.items.length > 0,
  education: education.items.length > 0,
  skills: skills.length > 0,
  publications: pubs.length > 0,
  talks: talks.length > 0,
  writing: posts.length > 0,
};
let n = 0;
const num = Object.fromEntries(
  Object.entries(present).map(([key, on]) => [key, on ? String(++n).padStart(2, '0') : ''])
) as Record<keyof typeof present, string>;
---

<Base description={site.description}>
  <section class="wrap hero">
    <div class="hero-text">
      <p class="eyebrow">{site.role}</p>
      <h1 class="hero-statement" set:html={emphasize(site.heroStatement)} />
      <p class="hero-bio">{site.bio}</p>
      <div class="hero-actions">
        <a class="btn" href={`mailto:${site.email}`}>
          Get in touch <span class="arr" aria-hidden="true">→</span>
        </a>
        {
          site.socials.map((s) => (
            <a class="link" href={s.url} rel="me noopener">
              {s.label} ↗
            </a>
          ))
        }
      </div>
    </div>

    <figure class="plate">
      <div class="map">
        <ObjectiveMap />
        <div class="map-portrait frame">
          {
            site.avatar ? (
              <Image
                src={site.avatar}
                alt={site.name}
                widths={[240, 480]}
                sizes="(max-width: 1000px) 229px, 208px"
                loading="eager"
                fetchpriority="high"
              />
            ) : (
              <div class="ph" aria-hidden="true" />
            )
          }
        </div>
      </div>
      {
        site.quote && (
          <figcaption class="portrait-quote">
            <p>&#8220;{site.quote.text}&#8221;</p>
            <span>{site.quote.attribution}</span>
          </figcaption>
        )
      }
    </figure>
  </section>

  {
    (present.experience || present.education) && (
      <div class="wrap home-row">
        <div class="split">
          {present.experience && (
            <section class="home-sec" id="experience" aria-labelledby="h-experience">
              <SectionHead
                num={num.experience}
                id="h-experience"
                title={experience.label}
                count={plural(experience.items.length, 'role', 'roles')}
              >
                {site.cvPdf && (
                  <a class="btn btn-sm btn-ghost" href={url(site.cvPdf)} download>
                    CV (PDF)
                  </a>
                )}
              </SectionHead>
              <div class="timeline">
                {experience.items.slice(0, SHOW.roles).map((role) => (
                  <RoleEntry role={role} />
                ))}
              </div>
              <MoreList
                count={experience.items.length - SHOW.roles}
                noun={['earlier role', 'earlier roles']}
              >
                <div class="timeline">
                  {experience.items.slice(SHOW.roles).map((role) => (
                    <RoleEntry role={role} />
                  ))}
                </div>
              </MoreList>
            </section>
          )}

          {present.education && (
            <section class="home-sec" id="education" aria-labelledby="h-education">
              <SectionHead
                num={num.education}
                id="h-education"
                title={education.label}
                count={plural(education.items.length, 'degree', 'degrees')}
              />
              <div class="edu-list">
                {education.items.map((degree) => (
                  <div class="edu-item reveal">
                    <span class="tl-date">{dateLabel(degree)}</span>
                    <h3>{degree.title}</h3>
                    <Organization entry={degree} />
                  </div>
                ))}
              </div>
              {training.items.length > 0 && (
                <div class="home-training">
                  <div class="mini-head reveal">
                    <span class="mini-label">{training.label}</span>
                    <span class="sec-count">{training.items.length}</span>
                  </div>
                  {training.items.slice(0, SHOW.training).map((entry) => (
                    <TrainingEntry entry={entry} />
                  ))}
                  <MoreList count={training.items.length - SHOW.training} noun={['more', 'more']}>
                    {training.items.slice(SHOW.training).map((entry) => (
                      <TrainingEntry entry={entry} />
                    ))}
                  </MoreList>
                </div>
              )}
            </section>
          )}
        </div>
      </div>
    )
  }

  {
    present.skills && (
      <section class="wrap home-sec home-row" aria-labelledby="h-skills">
        <SectionHead num={num.skills} id="h-skills" title="Skills & tools" />
        <div class="skills">
          {skills.map((group) => (
            <div class="skill-group reveal">
              <span class="mini-label">{group.label}</span>
              <ul class="tags">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    present.publications && (
      <section class="wrap home-sec home-row" id="publications" aria-labelledby="h-publications">
        <SectionHead
          num={num.publications}
          id="h-publications"
          title="Publications"
          count={plural(pubs.length, 'publication', 'publications')}
        />
        <div class="row-list">
          {pubs.slice(0, SHOW.publications).map((pub) => (
            <PublicationRow pub={pub} />
          ))}
          <MoreList
            count={pubs.length - SHOW.publications}
            noun={['more publication', 'more publications']}
          >
            {pubs.slice(SHOW.publications).map((pub) => (
              <PublicationRow pub={pub} />
            ))}
          </MoreList>
        </div>
      </section>
    )
  }

  {
    present.talks && (
      <section class="wrap home-sec home-row" id="talks" aria-labelledby="h-talks">
        <SectionHead
          num={num.talks}
          id="h-talks"
          title="Talks & posters"
          count={plural(talks.length, 'presentation', 'presentations')}
        />
        <div class="row-list">
          {talks.slice(0, SHOW.talks).map((talk) => (
            <TalkRow talk={talk} />
          ))}
          <MoreList
            count={talks.length - SHOW.talks}
            noun={['older presentation', 'older presentations']}
          >
            {talks.slice(SHOW.talks).map((talk) => (
              <TalkRow talk={talk} />
            ))}
          </MoreList>
        </div>
      </section>
    )
  }

  {
    latest && (
      <section class="wrap home-sec home-row" id="writing" aria-labelledby="h-writing">
        <SectionHead
          num={num.writing}
          id="h-writing"
          title="Writing"
          count={plural(posts.length, 'post', 'posts')}
        />
        <article class="home-post reveal">
          <div class="home-post-body">
            <span class="row-stamp">
              {['Latest', stampDate(latest.data.date), latest.data.category, `${readingMinutes(latest.body)} min`]
                .filter(Boolean)
                .join(' · ')}
            </span>
            <a class="home-post-title" href={url(`/writing/${latest.id}`)}>
              {latest.data.title}
            </a>
            <p class="home-post-desc">{latest.data.description}</p>
            <a class="more" href={url(`/writing/${latest.id}`)}>
              Read <span class="arr" aria-hidden="true">→</span>
              <span class="sr-only"> — {latest.data.title}</span>
            </a>
          </div>
          {latest.data.image && (
            <Placeholder
              class="home-post-media"
              src={latest.data.image}
              widths={[440, 880]}
              sizes="(max-width: 1000px) min(520px, 100vw), 420px"
              frame
            />
          )}
        </article>
        <MoreList count={olderPosts.length} noun={['older post', 'older posts']}>
          {olderPosts.map((post) => (
            <PostRow post={post} />
          ))}
        </MoreList>
      </section>
    )
  }

  <section class="wrap home-contact" id="contact" aria-labelledby="h-contact">
    <h2 id="h-contact" class="reveal">Get in <em>touch</em></h2>
    <div class="contact-actions reveal">
      <a class="btn" href={`mailto:${site.email}`}>
        {site.email} <span class="arr" aria-hidden="true">→</span>
      </a>
      {
        site.socials.map((s) => (
          <a class="link" href={s.url} rel="me noopener">
            {s.label} ↗
          </a>
        ))
      }
    </div>
  </section>
</Base>
