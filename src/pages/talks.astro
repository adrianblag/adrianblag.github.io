---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import FilterPills from '../components/FilterPills.astro';
import YearHead from '../components/YearHead.astro';
import Placeholder from '../components/Placeholder.astro';
import { pageIntros } from '../config/site';
import { talkTypes } from '../config/taxonomy';
import { groupByYear, resolveCategories, stampDate, year } from '../lib/format';

const all = (await getCollection('talks')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const groups = groupByYear(all, (t) => year(t.data.date));
const categories = resolveCategories(
  talkTypes,
  all.map((t) => t.data.type)
);
---

<Base title="Talks & posters" description={pageIntros.talks}>
  <div class="wrap page rv" data-filter-root>
    <PageHeader title="Talks &amp; posters" lead={pageIntros.talks}>
      <FilterPills categories={categories} label="Filter talks and posters by type" />
    </PageHeader>

    {
      groups.map((group) => (
        <section class="year-group" data-filter-list data-group>
          <YearHead year={group.year} count={group.items.length} noun="presentations" />
          {group.items.map((talk, i) => {
            // The title opens the slides when there are any, else the first link.
            const slides = talk.data.slides;
            const primary = slides ?? talk.data.links[0]?.url;
            const newTab = slides ? { target: '_blank', rel: 'noopener' } : {};
            const isLast = i === group.items.length - 1;
            return (
              <article
                class:list={['row', 'talk-row', { 'is-last-visible': isLast }]}
                data-category={talk.data.type}
              >
                <Placeholder
                  class="talk-thumb"
                  src={talk.data.image}
                  alt={talk.data.image ? talk.data.title : ''}
                  caption="talk image — optional"
                  widths={[168, 336, 440]}
                  sizes="(max-width: 560px) 220px, (max-width: 880px) 132px, 168px"
                  frame
                />
                <div class="talk-body">
                  <span class="row-stamp">
                    {stampDate(talk.data.date)} · {talk.data.type}
                  </span>
                  {primary ? (
                    <a class="row-title" href={primary} {...newTab}>
                      {talk.data.title}
                    </a>
                  ) : (
                    <h2 class="row-title">{talk.data.title}</h2>
                  )}
                  <span class="row-venue">
                    {[talk.data.event, talk.data.location]
                      .filter(Boolean)
                      .join(' · ')}
                  </span>
                  {talk.data.abstract && (
                    <span class="talk-abstract">{talk.data.abstract}</span>
                  )}
                </div>
                <div class="taglinks">
                  {slides && (
                    <a class="btn btn-sm btn-ghost" href={slides} {...newTab}>
                      Slides <span class="arr" aria-hidden="true">↗</span>
                      <span class="sr-only"> — {talk.data.title} (opens in a new tab)</span>
                    </a>
                  )}
                  {talk.data.links.map((l) => (
                    <a href={l.url}>
                      {l.label}
                      <span class="sr-only"> — {talk.data.title}</span>
                    </a>
                  ))}
                </div>
              </article>
            );
          })}
        </section>
      ))
    }

    <p class="filter-empty" data-filter-empty hidden>
      Nothing in this category yet.
    </p>

    {
      all.length === 0 && (
        <p class="filter-empty">
          No talks yet — add a Markdown file to <code>src/content/talks/</code>.
        </p>
      )
    }
  </div>
</Base>
