---
import { site, nav } from '../config/site';
import { url, isCurrent } from '../lib/format';
import ThemeToggle from './ThemeToggle.astro';

const here = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <a class="wordmark" href={url('/')}>{site.name}</a>
    <nav class="site-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={url(item.href)}
            aria-current={isCurrent(here, item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <ThemeToggle />
      <a class="btn btn-sm btn-ghost" href={`mailto:${site.email}`}>Get in touch</a>
    </div>
  </div>
</header>
