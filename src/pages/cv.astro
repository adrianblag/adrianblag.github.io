---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site, pageIntros } from '../config/site';
import { url } from '../lib/format';
import { cvSections as sections, dateLabel, isCurrentRole as isCurrent, logosOf } from '../lib/cv';
---

<Base title="CV" description={pageIntros.cv}>
  <div class="wrap page rv">
    <PageHeader title="Curriculum vitae" lead={pageIntros.cv}>
      {
        site.cvPdf && (
          <a class="cv-download" href={url(site.cvPdf)} download>
            Download CV (PDF)
          </a>
        )
      }
    </PageHeader>

    <div class="cv-grid" style="margin-top: 48px;">
      {
        sections.map((section) => (
          <section class="cv-section" style="display: contents;">
            <div class="cv-section-head">
              <h2 class="cv-section-label">{section.label}</h2>
              <span class="cv-section-rule" />
            </div>
            {section.items.map((entry, i) => {
              const logos = logosOf(entry);
              /* Logos are decorative: the organization name sits right
                 beside them and would otherwise be read out twice. */
              const marks = logos.map((src) => (
                <img class="cv-logo" src={url(src)} alt="" height="24" loading="lazy" />
              ));
              return (
                <Fragment>
                  <div class="cv-date">{dateLabel(entry)}</div>
                  <div
                    class:list={[
                      'cv-entry',
                      { 'is-last': i === section.items.length - 1 },
                    ]}
                  >
                    <span
                      class:list={['cv-dot', { 'is-current': isCurrent(entry) }]}
                      aria-hidden="true"
                    />
                    <h3 class="cv-title">{entry.title}</h3>
                    {entry.organization && (
                      <span class="cv-org">
                        {entry.url ? (
                          <a class="cv-org-link" href={entry.url}>
                            {marks}
                            <span class="cv-org-name">{entry.organization}</span>
                          </a>
                        ) : (
                          <span class="cv-org-link">
                            {marks}
                            <span>{entry.organization}</span>
                          </span>
                        )}
                      </span>
                    )}
                    {entry.bullets && entry.bullets.length > 0 && (
                      <ul class="cv-bullets">
                        {entry.bullets.map((b) => (
                          <li>{b}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </Fragment>
              );
            })}
          </section>
        ))
      }
    </div>
  </div>
</Base>
