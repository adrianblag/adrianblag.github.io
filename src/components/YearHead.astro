---
interface Props {
  year: number;
  count: number;
  /** plural noun for the count, e.g. "items" / "talks" / "posts" */
  noun: string;
}
const { year, count, noun } = Astro.props;
const singular = noun.replace(/s$/, '');
---

<div class="year-head">
  <span class="year-label">{year}</span>
  <span class="year-rule"></span>
  <span class="year-count" data-count data-noun={noun}>
    {count} {count === 1 ? singular : noun}
  </span>
</div>
